{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=netemplate;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "RabbitMQ": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Key": "ThisIsASecretKeyForDevelopmentOnly1234567890",
    "Issuer": "netemplate",
    "Audience": "netemplate-api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "https://localhost:3000"]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:01:00",
    "QueueLimit": 10
  },
  "OpenTelemetry": {
    "SamplingRatio": 0.1
  },
  "Security": {
    "MaxRequestBodySizeBytes": 5242880,
    "EnablePiiRedaction": true
  },
  "SecurityPolicies": {
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 100,
      "Window": "00:01:00",
      "QueueLimit": 10
    },
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": ["http://localhost:3000", "https://localhost:3000"],
      "AllowCredentials": true
    },
    "RequestLimits": {
      "MaxRequestBodySizeBytes": 5242880,
      "MaxConcurrentRequests": 1000
    }
  },
  "Secrets": {
    "Provider": "Environment",
    "EnableRotation": false,
    "RotationCheckInterval": "01:00:00"
  }
}
